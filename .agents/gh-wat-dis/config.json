{
  "$schema": "https://tjw.dev/gh-wat-dis/config.schema.json",
  "version": 1,
  "policy": {
    "use": "always",
    "confirmBeforeWrite": true
  },
  "repo": {
    "owner": "thejustinwalsh",
    "name": "gh-wat-dis",
    "defaultBranch": "main"
  },
  "issues": {
    "types": [
      "Task",
      "Bug",
      "Feature"
    ],
    "typeSource": "label"
  },
  "pulls": {
    "draft": false,
    "closingKeyword": "Closes"
  },
  "milestones": {
    "naming": "",
    "capacity": null
  },
  "triage": {
    "staleIssueDays": 60,
    "stalePrDays": 14
  },
  "architecture": {
    "system": {
      "name": "gh-wat-dis",
      "description": "Skills and tools that help agents write GitHub issues, pull requests and milestones"
    },
    "elements": [
      {
        "id": "engineer",
        "type": "person",
        "name": "Engineer",
        "description": "Reads issues and PRs, approves drafts",
        "paths": []
      },
      {
        "id": "agent",
        "type": "system",
        "name": "Coding agent",
        "external": true,
        "description": "Claude Code, Codex, Cursor and others. Loads the skills and runs the tools",
        "paths": []
      },
      {
        "id": "github",
        "type": "system",
        "name": "GitHub",
        "external": true,
        "description": "Holds issues, pull requests, milestones and attachments",
        "paths": []
      },
      {
        "id": "cccc",
        "type": "system",
        "name": "cccc",
        "external": true,
        "technology": "Rust binary",
        "description": "Scores the complexity of each function",
        "paths": []
      },
      {
        "id": "skills",
        "type": "container",
        "name": "wat skills",
        "technology": "Markdown",
        "description": "Tell the agent what to write and which tool to run",
        "paths": [
          "skills/**"
        ]
      },
      {
        "id": "cli",
        "type": "container",
        "name": "gh-wat-dis CLI",
        "technology": "TypeScript, Node",
        "description": "Dispatches one small tool per command",
        "paths": [
          "src/bin.ts",
          "src/main.ts",
          "src/graph-dispatch.ts",
          "src/spec.ts"
        ]
      },
      {
        "id": "setup",
        "type": "component",
        "parent": "cli",
        "name": "Setup tools",
        "technology": "TypeScript",
        "description": "install, init, mcp, doctor",
        "paths": [
          "src/cli/**",
          "src/tools/**"
        ]
      },
      {
        "id": "facts",
        "type": "component",
        "parent": "cli",
        "name": "Facts tools",
        "technology": "TypeScript, ast-grep",
        "description": "impact, reach, owners, elements, blast",
        "paths": [
          "src/impact/**"
        ]
      },
      {
        "id": "graph",
        "type": "component",
        "parent": "cli",
        "name": "Graph filters",
        "technology": "TypeScript",
        "description": "Reshape a diagram spec",
        "paths": [
          "src/graph/**"
        ]
      },
      {
        "id": "diagram",
        "type": "component",
        "parent": "cli",
        "name": "Diagram renderer",
        "technology": "TypeScript, elkjs",
        "description": "Lints a spec and draws an SVG",
        "paths": [
          "src/diagram/**",
          "examples/diagrams/**"
        ]
      },
      {
        "id": "ghtools",
        "type": "component",
        "parent": "cli",
        "name": "GitHub tools",
        "technology": "TypeScript, gh",
        "description": "related, links",
        "paths": [
          "src/gh/**"
        ]
      },
      {
        "id": "dis",
        "type": "component",
        "parent": "cli",
        "name": "Explanation command",
        "technology": "TypeScript",
        "description": "Composes thread reads, exact PR measurement and cached diagrams",
        "paths": [
          "src/dis/**"
        ]
      },
      {
        "id": "lint",
        "type": "component",
        "parent": "cli",
        "name": "Body backstop",
        "technology": "TypeScript",
        "description": "Catches what GitHub would break in a body",
        "paths": [
          "src/lint/**"
        ]
      },
      {
        "id": "site",
        "type": "container",
        "name": "Site",
        "technology": "Static HTML, GitHub Pages",
        "description": "Shows what the skills produce and serves llms.txt",
        "paths": [
          "docs/**",
          "scripts/site-*.ts"
        ]
      },
      {
        "id": "ci",
        "type": "container",
        "name": "CI and Pages workflows",
        "technology": "GitHub Actions",
        "description": "Checks each change and publishes the site",
        "paths": [
          ".github/**"
        ]
      }
    ],
    "relationships": [
      {
        "from": "engineer",
        "to": "agent",
        "label": "Asks for an issue, PR or milestone"
      },
      {
        "from": "agent",
        "to": "skills",
        "label": "Loads instructions from"
      },
      {
        "from": "agent",
        "to": "cli",
        "label": "Runs tools through",
        "technology": "npx"
      },
      {
        "from": "agent",
        "to": "github",
        "label": "Writes issues and PRs to",
        "technology": "gh CLI"
      },
      {
        "from": "agent",
        "to": "github",
        "label": "Reads threads and diffs from",
        "technology": "GitHub MCP server"
      },
      {
        "from": "ghtools",
        "to": "github",
        "label": "Searches issues and reads PR links from",
        "technology": "gh CLI"
      },
      {
        "from": "setup",
        "to": "skills",
        "label": "Copies into the harness",
        "technology": "file copy"
      },
      {
        "from": "facts",
        "to": "graph",
        "label": "Emits diagram specs for",
        "technology": "JSON"
      },
      {
        "from": "graph",
        "to": "diagram",
        "label": "Passes shaped specs to",
        "technology": "JSON"
      },
      {
        "from": "engineer",
        "to": "github",
        "label": "Reads the result on"
      },
      {
        "from": "ci",
        "to": "site",
        "label": "Publishes docs/ to GitHub Pages as",
        "technology": "actions/deploy-pages"
      },
      {
        "from": "ci",
        "to": "diagram",
        "label": "Renders the example diagrams with",
        "technology": "node src/bin.ts diagram"
      },
      {
        "from": "engineer",
        "to": "site",
        "label": "Reads what the skills produce on",
        "technology": "HTTPS"
      },
      {
        "from": "agent",
        "to": "site",
        "label": "Finds the install steps in llms.txt on",
        "technology": "HTTPS"
      },
      {
        "from": "setup",
        "to": "github",
        "label": "Downloads the pinned cccc release and checks its attestation on",
        "technology": "gh CLI"
      },
      {
        "from": "facts",
        "to": "cccc",
        "label": "Scores changed files on base and head with",
        "technology": "child process, JSON"
      },
      {
        "from": "facts",
        "to": "diagram",
        "label": "Holds code specs to the budget and three layers of",
        "technology": "TypeScript import"
      },
      {
        "from": "dis",
        "to": "ghtools",
        "label": "Reads issue and PR threads through",
        "technology": "TypeScript import"
      },
      {
        "from": "dis",
        "to": "facts",
        "label": "Measures requested PR snapshots with",
        "technology": "TypeScript import"
      },
      {
        "from": "dis",
        "to": "diagram",
        "label": "Renders explanation diagrams with",
        "technology": "TypeScript import"
      },
      {
        "from": "dis",
        "to": "github",
        "label": "Fetches requested PR base and head snapshots from",
        "technology": "git fetch"
      }
    ]
  },
  "labels": {
    "agents": "agents",
    "surfaces": [
      {
        "name": "skills",
        "description": "The wat skills and their reference files",
        "elements": [
          "skills"
        ]
      },
      {
        "name": "setup",
        "description": "install, init, mcp, doctor",
        "elements": [
          "setup",
          "cli"
        ]
      },
      {
        "name": "facts",
        "description": "impact, reach, owners, elements, blast",
        "elements": [
          "facts"
        ]
      },
      {
        "name": "graph",
        "description": "Graph filters that reshape a diagram spec",
        "elements": [
          "graph"
        ]
      },
      {
        "name": "diagram",
        "description": "The diagram renderer and its examples",
        "elements": [
          "diagram"
        ]
      },
      {
        "name": "github-tools",
        "description": "related, links, relations, labels",
        "elements": [
          "ghtools",
          "dis"
        ]
      },
      {
        "name": "body-check",
        "description": "The lint backstop for issue and PR bodies",
        "elements": [
          "lint"
        ]
      },
      {
        "name": "site",
        "description": "The landing page and llms.txt",
        "elements": [
          "site"
        ]
      },
      {
        "name": "ci",
        "description": "CI, Pages and release workflows",
        "elements": [
          "ci"
        ]
      }
    ]
  }
}
