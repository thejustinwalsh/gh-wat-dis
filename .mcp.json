{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headersHelper": "printf '{\"Authorization\":\"Bearer %s\"}' \"$(gh auth token)\"",
      "headers": {
        "X-MCP-Toolsets": "default,labels",
        "X-MCP-Readonly": "true"
      }
    }
  }
}
